export function adoptionIndex(s: { freq: number; qual: number; verif: number; maturity: number }, w: [number, number, number, number] = [0.3, 0.3, 0.2, 0.2]) {
  return w[0] * s.freq + w[1] * s.qual + w[2] * s.verif + w[3] * s.maturity;
